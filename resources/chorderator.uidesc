<?xml version="1.0" encoding="UTF-8"?>
<vstgui-ui-description version="1">
<colors>
<color name="Bg" rgba="#0D1115FF"/><color name="Panel" rgba="#19242CFF"/>
<color name="Text" rgba="#E7ECEFFF"/><color name="Muted" rgba="#9AA7B0FF"/>
<color name="Accent" rgba="#62C7B3FF"/><color name="Line" rgba="#35434CFF"/>
</colors>
<fonts><font name="Title" font-name="Arial" size="29" bold="true"/>
<font name="Heading" font-name="Arial" size="18" bold="true"/>
<font name="Normal" font-name="Arial" size="14"/><font name="Small" font-name="Arial" size="13"/></fonts>
<control-tags>
<control-tag name="Key" tag="100"/><control-tag name="Scale" tag="101"/>
<control-tag name="Chromatic" tag="102"/><control-tag name="Leading" tag="103"/>
<control-tag name="Character" tag="104"/><control-tag name="Double" tag="105"/>
<control-tag name="ControlBase" tag="106"/>
</control-tags>
<template name="ChorderatorView" class="CViewContainer" origin="0, 0" size="1120, 600" minSize="1120, 600" maxSize="1680, 900" background-color="Bg" transparent="false">
<view class="CTextLabel" origin="32, 22" size="800, 38" title="125A  CHORDERATOR" font="Title" font-color="Text" transparent="true"/>
<view class="CTextLabel" origin="34, 65" size="720, 22" title="INTELLIGENT MIDI CHORD ENGINE" font="Small" font-color="Muted" transparent="true"/>
<view class="CViewContainer" origin="24, 110" size="520, 170" background-color="Panel" transparent="false">
<view class="CTextLabel" origin="20, 14" size="480, 28" title="KEY &amp; SCALE" font="Heading" font-color="Accent" transparent="true"/>
<view class="CTextLabel" origin="20, 54" size="220, 20" title="KEY" font="Normal" font-color="Muted" transparent="true"/>
<view class="COptionMenu" control-tag="Key" origin="20, 79" size="220, 33" font-color="Text" back-color="Panel" frame-color="Line" frame-width="1" menu-popup-style="true"/>
<view class="CTextLabel" origin="270, 54" size="220, 20" title="SCALE" font="Normal" font-color="Muted" transparent="true"/>
<view class="COptionMenu" control-tag="Scale" origin="270, 79" size="220, 33" font-color="Text" back-color="Panel" frame-color="Line" frame-width="1" menu-popup-style="true"/>
<view class="CTextLabel" origin="20, 130" size="480, 20" title="Allowed notes: refer to KEY / SCALE (live display pending)" font="Small" font-color="Muted" transparent="true"/>
</view>
<view class="CViewContainer" origin="560, 110" size="536, 170" background-color="Panel" transparent="false">
<view class="CTextLabel" origin="20, 14" size="500, 28" title="VOICING" font="Heading" font-color="Accent" transparent="true"/>
<view class="CTextLabel" origin="20, 54" size="220, 20" title="VOICE LEADING" font="Normal" font-color="Muted" transparent="true"/>
<view class="COptionMenu" control-tag="Leading" origin="20, 79" size="220, 33" font-color="Text" back-color="Panel" frame-color="Line" frame-width="1" menu-popup-style="true"/>
<view class="CTextLabel" origin="270, 54" size="240, 20" title="CHARACTER" font="Normal" font-color="Muted" transparent="true"/>
<view class="COptionMenu" control-tag="Character" origin="270, 79" size="240, 33" font-color="Text" back-color="Panel" frame-color="Line" frame-width="1" menu-popup-style="true"/>
</view>
<view class="CViewContainer" origin="24, 300" size="520, 145" background-color="Panel" transparent="false">
<view class="CTextLabel" origin="20, 12" size="470, 25" title="PERFORMANCE" font="Heading" font-color="Accent" transparent="true"/>
<view class="CTextLabel" origin="20, 53" size="285, 22" title="ROOT OCTAVE DOUBLE" font="Normal" font-color="Text" transparent="true"/>
<view class="COptionMenu" control-tag="Double" origin="330, 47" size="160, 30" font-color="Text" back-color="Panel" frame-color="Line" frame-width="1" menu-popup-style="true"/>
<view class="CTextLabel" origin="20, 99" size="285, 22" title="CHROMATIC" font="Normal" font-color="Text" transparent="true"/>
<view class="COptionMenu" control-tag="Chromatic" origin="330, 94" size="160, 30" font-color="Text" back-color="Panel" frame-color="Line" frame-width="1" menu-popup-style="true"/>
