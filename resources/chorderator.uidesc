<view class="CViewContainer" origin="24, 464" size="1072, 110" background-color="Panel" transparent="false">
<view class="CTextLabel" origin="20, 14" size="1032, 27" title="CURRENT CHORD / OUTPUT NOTES" font="Heading" font-color="Accent" transparent="true"/>
